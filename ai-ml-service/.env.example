# Environment configuration for ai-ml-service (T-04 scaffold, US-16)
# Safe defaults only — never commit real secrets or API keys (NFR10).
# Every value here is a DR3 configurable limit (US-16).
# Copy this file to .env (git-ignored) and override for your host.

PORT=8000
LLM_API_KEY=your_key_here
LLM_MODEL=gemini-1.5-flash

# LLM request timeout in seconds (FR40.4 / US-16)
LLM_TIMEOUT_SECONDS=10.0

# FR37.2 – slowdown factor applied when the AI is throttled.
# 1.0 = no slowdown; >1.0 adds artificial delay. (US-16 creates this entry; US-77 uses it.)
AI_SLOWDOWN_FACTOR=1.0

# FR40.4 – maximum tokens the AI may generate per request (US-16 creates; US-24 enforces).
AI_MAX_TOKENS_PER_REQUEST=4096

# NFR5.3 – hourly per-room AI request limit (US-22 / US-16 creates this entry).
ROOM_HOURLY_LIMIT=20

# NFR7.2 – monthly spend cap in USD. 0.0 = no cap (placeholder until US-77).
MONTHLY_BUDGET_USD=10.0

# Cost rate used to estimate spend (FR40.4, US-16). Set to your model's actual rate.
TOKEN_COST_PER_TOKEN=0.0000035

# Relevant code section limits (FR40.2, US-76, NFR8.2)
SECTION_WINDOW_LINES=10
SECTION_MAX_LINES=30
SECTION_FALLBACK_LINES=20

# FR37.2, DR3 – Slowdown detection configurable limits (US-68, §16.2)
SLOWDOWN_FACTOR_THRESHOLD=8.0
SLOWDOWN_OUTLIER_THRESHOLD=3.0
SLOWDOWN_MODIFIED_Z_THRESHOLD=3.0
SLOWDOWN_MIN_SAMPLES=3
SLOWDOWN_MAX_HISTORY=100

