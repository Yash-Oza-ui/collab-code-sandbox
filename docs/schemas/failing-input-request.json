{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FailingInputAnalysisRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_type": {
      "type": "string",
      "const": "failing_input"
    },
    "language": {
      "type": "string",
      "enum": [
        "cpp",
        "python",
        "c",
        "java",
        "javascript"
      ]
    },
    "consent": {
      "type": "boolean"
    },
    "ai_enabled": {
      "type": "boolean"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "reference_solution": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "room_id",
    "analysis_id",
    "request_type",
    "language",
    "consent",
    "ai_enabled",
    "code"
  ],
  "additionalProperties": false
}
