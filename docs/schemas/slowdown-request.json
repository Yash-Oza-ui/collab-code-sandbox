{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlowdownAnalysisRequest",
  "type": "object",
  "properties": {
    "request_id": { "type": "string" },
    "room_id": { "type": "string" },
    "analysis_id": { "type": "string" },
    "request_type": { "type": "string", "enum": ["slowdown"] },
    "language": { "type": "string", "enum": ["cpp", "python", "c", "java", "javascript"] },
    "consent": { "type": "boolean" },
    "ai_enabled": { "type": "boolean" },
    "input_hash": { "type": "string" },
    "current_run": {
      "type": "object",
      "properties": {
        "execution_time_ms": { "type": "number" },
        "peak_memory_mb": { "type": "number" },
        "code": { "type": "string" }
      },
      "required": ["execution_time_ms", "peak_memory_mb", "code"],
      "additionalProperties": false
    }
  },
  "required": [
    "request_id",
    "room_id",
    "analysis_id",
    "request_type",
    "language",
    "consent",
    "ai_enabled",
    "input_hash",
    "current_run"
  ],
  "additionalProperties": false
}
