# Copy to .env (git-ignored) to override the defaults used by
# docker-compose.yml and tests/integration/*.sh.
# Ports and health paths are PROVISIONAL until T-06 (docs/api-contracts.md).
# Never put real keys in this file; it is committed.

CLIENT_PORT=3000
CLIENT_HEALTH_PATH=/

SYNC_SERVICE_PORT=8081
SYNC_SERVICE_HEALTH_PATH=/actuator/health

EXECUTION_SERVICE_PORT=8082
EXECUTION_SERVICE_HEALTH_PATH=/actuator/health

AI_ML_SERVICE_PORT=8000
AI_ML_SERVICE_HEALTH_PATH=/health

# Seconds the smoke test waits in total for services to come up.
SMOKE_TIMEOUT=60
