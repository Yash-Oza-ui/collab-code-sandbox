# Copy to .env (git-ignored) to override the defaults used by
# docker-compose.yml and tests/integration/*.sh.
# Ports and health paths are PROVISIONAL until T-06 (docs/api-contracts.md).
# Never put real keys in this file; it is committed.
#
# US-16 (DR3): Every configurable DR3 limit is listed here with its
# default value. See docs/host-config.md for the owner service and config key.

CLIENT_PORT=3000
CLIENT_HEALTH_PATH=/

SYNC_SERVICE_PORT=8081
SYNC_SERVICE_HEALTH_PATH=/actuator/health

EXECUTION_SERVICE_PORT=8082
EXECUTION_SERVICE_HEALTH_PATH=/actuator/health

# Actuator health details are hidden by default (never). tests/integration/up.sh
# sets MANAGEMENT_HEALTH_SHOW_DETAILS=always for the test stack only. Do not
# set it to always for a deployed stack.
# MANAGEMENT_HEALTH_SHOW_DETAILS=never

AI_ML_SERVICE_PORT=8000
AI_ML_SERVICE_HEALTH_PATH=/health

# Seconds the smoke test waits in total for services to come up.
SMOKE_TIMEOUT=60

# Shared secret for internal inter-service endpoints (T-17 V2.10, V2.11).
# In production/deployment, set a strong random secret. Never commit secrets (NFR10).
# INTERNAL_API_TOKEN=

# -----------------------------------------------------------------------
# execution-service resource limits (DR3, NFR4, US-13, US-16)
# Owner: execution-service (application.yml, app.execution.limits.*)
# -----------------------------------------------------------------------
# NFR4.1 – wall-clock time limit per run (seconds)
APP_EXECUTION_LIMITS_WALL_TIME_SECONDS=5
# NFR4.2 – max memory per container (MB, swap disabled)
APP_EXECUTION_LIMITS_MEMORY_MB=128
# NFR4.3 – max processes/threads inside the container
APP_EXECUTION_LIMITS_PIDS_LIMIT=64
# NFR4.4 – max total output (stdout + stderr, bytes)
APP_EXECUTION_LIMITS_MAX_OUTPUT_BYTES=1048576
# NFR4.5 – compile-stage timeout (seconds)
APP_EXECUTION_LIMITS_COMPILE_TIMEOUT_SECONDS=10
# FR16 – max concurrent runs in queue
EXECUTION_MAX_QUEUE_LENGTH=10
# FR16 – Retry-After seconds on QUEUE_FULL
APP_EXECUTION_LIMITS_QUEUE_RETRY_AFTER_SECONDS=5
# NFR14 / US-64 – aggregate wall-clock time budget per repeated-run request (ms)
APP_EXECUTION_LIMITS_AGGREGATE_TIME_BUDGET_MS=20000
# NFR14 / US-64 – maximum number of runs per repeated-run request
APP_EXECUTION_LIMITS_MAX_RUNS_PER_REQUEST=10
# NFR14 / US-64 – Retry-After seconds on RUN_BUDGET_EXCEEDED
APP_EXECUTION_LIMITS_BUDGET_RETRY_AFTER_SECONDS=30

# -----------------------------------------------------------------------
# sync-service room limits (DR3, NFR15, FR31.2, NFR14, US-16)
# Owner: sync-service (application.properties, app.room.limits.*)
# -----------------------------------------------------------------------
# NFR15 – max members per room
APP_ROOM_LIMITS_MAX_MEMBERS_PER_ROOM=10
# FR31.2 – host-leaves timeout (ms) before room is force-closed
APP_ROOM_LIMITS_HOST_LEAVES_TIMEOUT_MS=30000
# NFR14 – aggregate run budget per session (ms). 0 = no cap (US-63 pending)
APP_ROOM_LIMITS_AGGREGATE_RUN_BUDGET_MS=0
# NFR14 – max runs per session. 0 = no cap (US-63 pending)
APP_ROOM_LIMITS_MAX_RUNS_PER_SESSION=0

# sync-service execution history retention (FR15 / US-30; proposed defaults)
APP_RUN_HISTORY_RETENTION_SECONDS=86400
APP_RUN_HISTORY_SWEEP_INTERVAL_MS=60000

# -----------------------------------------------------------------------
# ai-ml-service limits (DR3, FR37.2, FR40.4, NFR5.3, NFR7.2, US-16)
# Owner: ai-ml-service (.env / environment, app/config.py)
# -----------------------------------------------------------------------
# FR37.2 – slowdown factor (1.0 = none; US-77 pending)
AI_SLOWDOWN_FACTOR=1.0
# FR40.4 – max tokens per AI request (US-24). Canonical name; LLM_MAX_OUTPUT_TOKENS accepted as legacy alias.
AI_MAX_TOKENS_PER_REQUEST=4096
# FR40.4 – LLM request timeout (seconds)
LLM_TIMEOUT_SECONDS=10.0
# NFR5.3 – hourly per-room AI request cap
ROOM_HOURLY_LIMIT=20
# NFR7.2 – monthly spend cap in USD (US-24). Must be a finite positive number (> 0.0).
MONTHLY_BUDGET_USD=10.0
# Cost rate for spend estimation (USD per token)
TOKEN_COST_PER_TOKEN=0.0000035
