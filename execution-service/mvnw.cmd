@REM Maven wrapper batch script for Windows.
@REM Generated by: mvn wrapper:wrapper -Dmaven=3.9.9
@REM Do not edit by hand.

@echo off
setlocal

set SCRIPT_DIR=%~dp0
set MAVEN_WRAPPER_PROPERTIES=%SCRIPT_DIR%.mvn\wrapper\maven-wrapper.properties

for /f "usebackq tokens=2 delims==" %%A in (`findstr /b "distributionUrl" "%MAVEN_WRAPPER_PROPERTIES%"`) do set DIST_URL=%%A

set MAVEN_USER_HOME=%USERPROFILE%\.m2
for %%F in ("%DIST_URL%") do set DIST_NAME=%%~nF
set MAVEN_HOME=%MAVEN_USER_HOME%\wrapper\dists\%DIST_NAME%

if not exist "%MAVEN_HOME%\bin\mvn.cmd" (
    if not exist "%MAVEN_HOME%" mkdir "%MAVEN_HOME%"
    echo Downloading %DIST_URL%
    powershell -Command "Invoke-WebRequest -Uri '%DIST_URL%' -OutFile '%MAVEN_HOME%\mvn-dist.zip'"
    powershell -Command "Expand-Archive -Path '%MAVEN_HOME%\mvn-dist.zip' -DestinationPath '%MAVEN_HOME%'"
    del "%MAVEN_HOME%\mvn-dist.zip"
    for /d %%D in ("%MAVEN_HOME%\apache-maven-*") do (
        xcopy /e /i /q "%%D\*" "%MAVEN_HOME%\" >nul
        rmdir /s /q "%%D"
    )
)

"%MAVEN_HOME%\bin\mvn.cmd" %*
endlocal
