# Maven wrapper shell script for Unix/macOS.
# Generated by: mvn wrapper:wrapper -Dmaven=3.9.9
# Do not edit by hand.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_PROJECTBASEDIR="$SCRIPT_DIR"

MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  distributionUrl=$(sed -n 's/distributionUrl=//p' "$MAVEN_WRAPPER_PROPERTIES" | tr -d '\r')
else
  echo "ERROR: $MAVEN_WRAPPER_PROPERTIES not found." >&2; exit 1
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
distributionName="$(basename "$distributionUrl" .zip)"
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/$distributionName"

if [ ! -d "$MAVEN_HOME/bin" ]; then
  mkdir -p "$MAVEN_HOME"
  tmpFile="$MAVEN_HOME/mvn-dist.zip"
  echo "Downloading $distributionUrl"
  curl -fLo "$tmpFile" "$distributionUrl" || wget -q -O "$tmpFile" "$distributionUrl"
  unzip -q "$tmpFile" -d "$MAVEN_HOME"
  rm "$tmpFile"
  mv "$MAVEN_HOME/$distributionName/"* "$MAVEN_HOME/" 2>/dev/null || true
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
