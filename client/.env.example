# ==============================================================================
# Collab Code Sandbox — Client Environment Configuration (T-01, T-06)
# ==============================================================================
# Copy this template to .env or .env.local for local overrides:
#   cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to browser code.
# Never commit real credentials, API tokens, or internal secrets to any .env file.
# ==============================================================================

# Base URL of the sync-service WebSocket relay (T-06 Section 1 & Section 3.1)
# The client connects directly to: {VITE_SYNC_WS_URL}/{room_id}?session_id={session_id}
VITE_SYNC_WS_URL=ws://localhost:8081/ws/rooms

# Base URL of the execution-service REST API (T-06 Section 1 & Section 4.1)
# The client posts run requests directly to: {VITE_EXECUTION_API_URL}/v1/runs
VITE_EXECUTION_API_URL=http://localhost:8082
